# Deny-by-default: nothing is tracked unless explicitly allow-listed below.
# ~/.claude holds credentials, session transcripts, and other sensitive
# runtime state alongside the setup files this repo actually wants.
/*

!/.gitignore
!/README.md
!/CLAUDE.md
!/settings.json
!/.github/
!/skills/

# Claude Code-managed copies of the skills enabled on claude.ai.
/skills/synced/
